ENV=dev
TAG=${ENV}
PHP_VERSION=8.5.10
PHP_IMAGE=php:${PHP_VERSION}-apache
VERSION=9.3.3
FILEBEAT_VERSION=docker.elastic.co/beats/filebeat:${VERSION}
ES_VERSION=docker.elastic.co/elasticsearch/elasticsearch:${VERSION}
