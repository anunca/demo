ENV=dev
TAG=${ENV}

CERTBOT_VERSION=v5.7.0
CERTBOT_IMAGE=certbot/dns-route53:${CERTBOT_VERSION}
NGINX_VERSION=1.31.4
NGINX_IMAGE=nginx:${NGINX_VERSION}-alpine
HTTPD_VERSION=2.4.68
HTTPD_IMAGE=httpd:${HTTPD_VERSION}-alpine

DOMAIN_NAME=app.internal
REGISTRY=registry.${DOMAIN_NAME}
COMPOSE_PROJECT_NAME=certbot
IMAGE=${REGISTRY}/${COMPOSE_PROJECT_NAME}:${TAG}

SERVER_NAME=appdemo.name
DOMAINS=${SERVER_NAME},*.${SERVER_NAME}
EMAIL=admin@appdemo.name
