ENV=dev
TAG=${ENV}

NGINX_VERSION=1.31.4
NGINX_IMAGE=nginx:${NGINX_VERSION}-alpine-slim
APACHE_VERSION=2.4.66
APACHE_IMAGE=httpd:${APACHE_VERSION}-alpine

PHP_VERSION=8.5.10
PHP_IMAGE=php:${PHP_VERSION}-fpm-alpine

DOMAIN_NAME=app.internal
REGISTRY=registry.${DOMAIN_NAME}
COMPOSE_PROJECT_NAME=ssl
APP_IMAGE=${REGISTRY}/${COMPOSE_PROJECT_NAME}:${TAG}
DOMAIN_NAME_SSL=app.com
