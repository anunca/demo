#DOCKERFILE=Dockerfile
DOCKERFILE=Dockerfile.alpine
#OS_VERSION=20.04
#OS_IMAGE=ubuntu:${OS_VERSION}
OS_VERSION=3.23.4
OS_IMAGE=alpine:${OS_VERSION}

DOMAIN_NAME=app.internal
REGISTRY=registry.${DOMAIN_NAME}
COMPOSE_PROJECT_NAME=nfs
APP_IMAGE=${REGISTRY}/${COMPOSE_PROJECT_NAME}:${TAG}

NFS_DIRECTORY=/srv/nfs4/data
NFS_HOST=*
NFS_OPTIONS=fsid=0,rw,async,no_subtree_check,no_root_squash
