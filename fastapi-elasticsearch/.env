PYTHON_VERSION=3.14.4-alpine
PYTHON_IMAGE=python:${PYTHON_VERSION}
NGINX_VERSION=1.30.0-alpine-slim
NGINX_IMAGE=nginx:${NGINX_VERSION}
ELASTICSEARCH_VERSION=8.18.0
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:${ELASTICSEARCH_VERSION}
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

DOMAIN_NAME=app.internal
REGISTRY=registry.${DOMAIN_NAME}
COMPOSE_PROJECT_NAME=usage-collector
IMAGE=${REGISTRY}/${COMPOSE_PROJECT_NAME}:${TAG}
